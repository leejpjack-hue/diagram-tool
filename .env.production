# Production-only Vite env (loaded by `vite build` / Workers Builds / wrangler).
# GA4 measurement IDs are public client identifiers, inlined into the landing bundle.
# PostHog is intentionally unset so GA4 is the active analytics tool.
VITE_POSTHOG_KEY=
VITE_GA4_MEASUREMENT_ID=G-HLTGGMPREJ

