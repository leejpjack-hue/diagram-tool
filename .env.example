# Optional analytics. The landing never blocks if these are unset (safe no-op).
# Prefer PostHog; GA4 is used only when the PostHog key is missing.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_GA4_MEASUREMENT_ID=

# Optional path for waitlist JSONL on the preview/dev host (defaults to ./data/waitlist.jsonl).
WAITLIST_FILE=
