# Optional analytics. The landing never blocks if these are unset (safe no-op).
# Prefer PostHog when VITE_POSTHOG_KEY is set; otherwise GA4 if VITE_GA4_MEASUREMENT_ID is set.
# Production builds load `.env.production` (GA4 G-HLTGGMPREJ, PostHog unset).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_GA4_MEASUREMENT_ID=

