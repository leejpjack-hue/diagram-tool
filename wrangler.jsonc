{
  "name": "diagram-tool",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-04",
  // Vite inlines VITE_* from `.env.production` during `npm run build`.
  // Do not put VITE_GA4_MEASUREMENT_ID in Worker runtime `vars` — that is too late.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
