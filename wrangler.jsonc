{
  "name": "diagram-tool",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WAITLIST",
        "class_name": "WaitlistStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["WaitlistStore"]
    }
  ]
}
