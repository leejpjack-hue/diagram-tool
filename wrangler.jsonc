{
  "name": "diagram-tool",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "DIAGRAM_SKILLS", "class_name": "DiagramSkillsAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DiagramSkillsAgent"] }],
  // Vite inlines VITE_* from `.env.production` during `npm run build`.
  // Do not put VITE_GA4_MEASUREMENT_ID in Worker runtime `vars` — that is too late.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/google64b6c4e267d551f7.html"]
  }
}
